<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <xsd:element name="User">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="email" type="xsd:string"/>
                <xsd:element name="role" type="xsd:string"/>
                <xsd:element name="full_name" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="City">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="name" type="xsd:string"/>
                <xsd:element name="crossroad_numbers" type="xsd:int"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="RoadSegment">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="city_id" type="xsd:int"/>
                <xsd:element name="start_coord" type="xsd:string"/>
                <xsd:element name="end_coord" type="xsd:string"/>
                <xsd:element name="length" type="xsd:float"/>
                <xsd:element name="quality_factor" type="xsd:float"/>
                <xsd:element name="user_intensity" type="xsd:float"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="Crossroad">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="city_id" type="xsd:int"/>
                <xsd:element name="coord" type="xsd:string"/>
                <xsd:element name="type" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="CrossroadLink">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="crossroad_id" type="xsd:int"/>
                <xsd:element name="road_segment_id" type="xsd:int"/>
                <xsd:element name="road_degree" type="xsd:int"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="RoadItem">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="item_type" type="xsd:string"/>
                <xsd:element name="coord" type="xsd:string"/>
                <xsd:element name="weight" type="xsd:float"/>
                <xsd:element name="actuality" type="xsd:boolean"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="RoadItemLink">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="road_item_id" type="xsd:int"/>
                <xsd:element name="road_segment_id" type="xsd:int"/>
                <xsd:element name="factor_number" type="xsd:float"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="Request">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="user_id" type="xsd:int"/>
                <xsd:element name="start_point" type="xsd:string"/>
                <xsd:element name="end_point" type="xsd:string"/>
                <xsd:element name="datetime" type="xsd:dateTime"/>
                <xsd:element name="preference_parameter" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="Route">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="request_id" type="xsd:int"/>
                <xsd:element name="total_distance" type="xsd:float"/>
                <xsd:element name="time" type="xsd:float"/>
                <xsd:element name="total_weight" type="xsd:float"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="Video">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="user_id" type="xsd:int"/>
                <xsd:element name="cloud_link" type="xsd:string"/>
                <xsd:element name="timelapses_json" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="ImageTimeframe">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id" type="xsd:int"/>
                <xsd:element name="video_id" type="xsd:int"/>
                <xsd:element name="cloud_link" type="xsd:string"/>
                <xsd:element name="coord" type="xsd:string"/>
                <xsd:element name="reliability_factor" type="xsd:float"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
